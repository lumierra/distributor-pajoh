{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "moduleResolution": "bundler",
        "module": "ESNext",
        "target": "ES2022",
        "jsx": "preserve",
        "strict": false,
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.js",
        "resources/js/**/*.vue"
    ]
}
